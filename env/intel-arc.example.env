# Intel Arc A770 on TrueNAS SCALE: per-host env for the universal Purah compose.
# The TrueNAS deploy uses truenas-app/docker-compose.yaml, which carries these same values inline.
# Listed here so every host shares ONE compose shape.
RENDER_NODE=/dev/dri/renderD128
LIBVA_DRIVER=iHD
# group_add GIDs (video / render / apps on TrueNAS): match the GroupAdd of Plex/Tdarr on that host.
VIDEO_GID=44
RENDER_GID=107
INPUT_GID=568
WOLF_STATE=/mnt/games/wolf
