# Per-host env for the universal Purah compose (compose/docker-compose.universal.yaml).
# Copy to <host>.env, fill in, and `docker compose --env-file env/<host>.env up -d`.
# The compose shape is identical on every host; ONLY these values change (see docs/PORTABILITY.md).

# GPU render node. Find it: `ls -l /dev/dri/by-path/` then pick the encode GPU's renderD12x.
RENDER_NODE=/dev/dri/renderD128

# libva driver for the encode GPU's VAAPI:
#   Intel Arc/iGPU -> iHD      AMD (RDNA/GCN) -> radeonsi      (NVIDIA uses nvcodec, not VAAPI)
LIBVA_DRIVER=radeonsi

# group_add GIDs so the container can reach /dev/dri + uinput. Find: `getent group video render input`
VIDEO_GID=44
RENDER_GID=991
INPUT_GID=995

# Host path for Wolf state (config/cert/pairings). MUST bind-mount at the SAME path in & out.
WOLF_STATE=/mnt/games/wolf

# -----------------------------------------------------------------------------
# Site values used by the docs/runbooks (not read by the compose). Export these in
# your shell before following docs/RUNBOOK.md or docs/DEPLOY-AMD-VM.md.
# Keep real values in a local, git-ignored file (e.g. env/site.local.env).
# -----------------------------------------------------------------------------
NAS_HOST=192.0.2.20            # TrueNAS host running the Wolf custom app
NAS_USER=truenas_admin         # SSH user on the TrueNAS host (key auth)
STREAM_HOST=192.0.2.194        # Moonlight target for the VM instance
PVE_HOST=192.0.2.5             # Proxmox node hosting the GPU VM
ISCSI_PORTAL=192.0.2.9         # TrueNAS iSCSI portal serving the VM's games disk
ISCSI_TARGET_IQN=iqn.2005-10.org.freenas.ctl:purah
ISCSI_INITIATOR_IQN=iqn.2025-06.example.purah:vm
# SUDO_PW: never store it here; export it from your secret manager at runtime.
